node_modules/
dist/
# Real values stay local: `.env` and `.env.production.local` are what docker-compose injects, and the
# `.env.<mode>.local` overrides (ignored by the repo root) beat the committed templates
# (`.env.development`, `.env.production`).
.env
.env.production.local
rush-logs/
*.tsbuildinfo
# The container's log directory is a compose bind mount: the directory itself is tracked (so the
# mount target exists with sane ownership), what lands in it is not.
logs/*
!logs/.gitkeep
