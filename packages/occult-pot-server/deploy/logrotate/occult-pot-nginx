# nginx has no rotation of its own, and the access log it writes into the repository's `logs/`
# (deploy/nginx/default.conf) is the one fail2ban tails. `copytruncate` is why this file needs no
# postrotate hook: the alternative would be `docker compose exec nginx nginx -s reopen` after each
# rotation, which means logrotate driving docker.
#
# The app's own log is deliberately absent: it rotates itself (OPS_LOG_ROTATING_FILE_MAX_SIZE /
# _MAX_FILES) and rotating it from here would fight the file sink.
#
# Install and check (the path is the deployment's; adjust it to where the repository is checked out):
#   sudo cp deploy/logrotate/occult-pot-nginx /etc/logrotate.d/
#   sudo logrotate -d /etc/logrotate.d/occult-pot-nginx   # dry run, prints what it would do

/home/ubuntu/tampermonkey-scripts/packages/occult-pot-server/logs/nginx-access.log {
    daily
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    # The log directory belongs to the deployment user; rotate as root explicitly.
    su root root
}
