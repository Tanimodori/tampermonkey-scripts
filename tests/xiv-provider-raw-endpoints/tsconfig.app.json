{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    /*
      No DOM: every web global these entries' types name — `Response`, `globalThis.fetch`, `Buffer` inside
      `WebFetcher` — is read from `@types/node` (undici-types), which is the same flavour the providers compile
      against. Adding DOM would bind a second, browser-shaped declaration over each of those names. What this
      project checks is the build, not the browser surface of the entries.
    */
    "lib": ["ES2022"],
    "types": ["node"],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    /*
      Reading a `.d.ts` without judging it: the declarations a provider ships are that package's own business.
      `dist/` is a vite build with no declarations, so nothing here resolves it — the specs read it as text.
    */
    "skipLibCheck": true,

    /* tsc -b's incremental state. */
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  "include": ["src/**/*.ts"]
}
