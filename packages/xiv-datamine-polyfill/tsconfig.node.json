{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    /* 构建与测试是 Node 侧：这里补上 node 类型，其余选项随 app 继承。 */
    "types": ["node"],
    /* `@/` 保留给 `test/`：`src/` 内部的导入一律相对，生成声明里才不会出现只有本包认识的说明符。这个别名
       只为让 vitest 与类型检查对同一件事达成一致；端到端 spec 与消费方检查在
       `tests/xiv-datamine-polyfill-e2e-test`，那里每个导入都经过本包 `exports`。 */
    "paths": {
      "@/*": ["./src/*"]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts", "test/**/*.ts"]
}
