{
  "name": "xivanalysis-zh",
  "version": "0.0.6",
  "private": true,
  "description": "Fill in the missing Chinese translations for xivanalysis.",
  "homepage": "https://github.com/Tanimodori/tampermonkey-scripts#readme",
  "bugs": {
    "url": "https://github.com/Tanimodori/tampermonkey-scripts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tanimodori/tampermonkey-scripts.git"
  },
  "license": "MIT",
  "author": "Tanimodori",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "bake:statuses": "node scripts/bake-statuses.mjs",
    "bake:statuses:check-upstream": "node scripts/bake-statuses.mjs --check-upstream",
    "bake:statuses:verify": "node scripts/bake-statuses.mjs --verify",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "test:e2e:fast": "vite build && playwright test --project=offline-injected",
    "test:e2e:full": "vite build && playwright test --project=offline-tampermonkey",
    "test:live:upstream": "playwright test --config=playwright.live.config.ts --project=live-upstream && vitest run --config=vitest.live.config.ts",
    "test:live:smoke": "vite build && playwright test --config=playwright.live.config.ts --project=live-smoke --grep @smoke",
    "test:corpus:capture": "vite build && playwright test --config=playwright.live.config.ts --project=live-corpus",
    "test:gate:offline": "vitest run --passWithNoTests && tsc -b && vite build && playwright test --project=offline-injected --project=offline-tampermonkey",
    "test:gate:live": "vite build && playwright test --config=playwright.live.config.ts --project=live-upstream --project=live-smoke && vitest run --config=vitest.live.config.ts"
  },
  "dependencies": {
    "xiv-garland-provider": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.10.5",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-userscript-metadata": "workspace:*",
    "vitest": "^5.0.1",
    "jsdom": "~30.1.3"
  },
  "optionalDependencies": {
    "@oxfmt/binding-win32-x64-msvc": "^0.67.0",
    "@oxlint/binding-win32-x64-msvc": "^1.82.0",
    "@rolldown/binding-win32-x64-msvc": "~1.2.6",
    "lightningcss-win32-x64-msvc": "^1.33.0"
  }
}
