{
  "name": "occult-pot-server",
  "version": "0.0.1",
  "private": true,
  "description": "Express API server proxying the Tencent Docs smartsheet that tracks occult pot refresh times.",
  "homepage": "https://github.com/Tanimodori/tampermonkey-scripts#readme",
  "bugs": {
    "url": "https://github.com/Tanimodori/tampermonkey-scripts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tanimodori/tampermonkey-scripts.git"
  },
  "license": "MIT",
  "author": "Tanimodori",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:redis && npm run test:api",
    "test:unit": "vitest --run --passWithNoTests",
    "test:redis": "cross-env OPS_ENV_PATH=.env.test-redis vitest --run --no-file-parallelism --tags-filter=redis",
    "test:api": "cross-env OPS_ENV_PATH=.env.test-api vitest --run --tags-filter=api",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@logtape/file": "^2.3.4",
    "@logtape/logtape": "^2.3.4",
    "@logtape/redaction": "^2.3.4",
    "@prometheus-io/client": "^0.16.1",
    "body-parser": "^2.3.0",
    "cors": "^2.8.6",
    "defu": "^6.1.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.8.0",
    "ioredis-mock": "^8.13.1",
    "morgan": "^1.12.1",
    "rate-limit-redis": "^6.0.1",
    "throttled-queue": "^3.0.0",
    "undici": "^7.16.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/ioredis-mock": "^8",
    "@types/morgan": "^1.9.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "cross-env": "^10.1.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "optionalDependencies": {
    "@oxfmt/binding-win32-x64-msvc": "^0.67.0",
    "@oxlint/binding-win32-x64-msvc": "^1.82.0",
    "@rolldown/binding-win32-x64-msvc": "~1.2.6",
    "lightningcss-win32-x64-msvc": "^1.33.0"
  }
}
