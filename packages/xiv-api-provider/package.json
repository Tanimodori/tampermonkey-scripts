{
  "name": "xiv-api-provider",
  "version": "0.0.1",
  "private": true,
  "description": "Online access to the FFXIV data sources the Chinese-localizing userscripts read: xivapi in two editions, the Garland Tools mirror, and the datamining CSV dumps.",
  "homepage": "https://github.com/Tanimodori/tampermonkey-scripts#readme",
  "bugs": {
    "url": "https://github.com/Tanimodori/tampermonkey-scripts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tanimodori/tampermonkey-scripts.git"
  },
  "license": "MIT",
  "author": "Tanimodori",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest --passWithNoTests",
    "test:live": "cross-env XIV_LIVE=1 vitest run --tags-filter=live",
    "test:drift": "cross-env XIV_LIVE=1 vitest run test/live"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.1",
    "@types/node": "^22.10.5",
    "cross-env": "^10.1.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "unplugin-dts": "^1.1.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "@types/papaparse": "~5.5.2"
  },
  "optionalDependencies": {
    "@oxfmt/binding-win32-x64-msvc": "^0.67.0",
    "@oxlint/binding-win32-x64-msvc": "^1.82.0",
    "@rolldown/binding-win32-x64-msvc": "~1.2.6",
    "lightningcss-win32-x64-msvc": "^1.33.0"
  },
  "dependencies": {
    "zod": "^4.6.5",
    "papaparse": "~5.7.0"
  }
}
