{
  "name": "xiv-datamine-polyfill-e2e-test",
  "version": "0.0.1",
  "private": true,
  "description": "Consumer-side checks for the xiv packages: probe files that typecheck the built dist/ through package.json#exports, and the vite build and dev-server end-to-end tests for xiv-datamine-polyfill.",
  "homepage": "https://github.com/Tanimodori/tampermonkey-scripts#readme",
  "bugs": {
    "url": "https://github.com/Tanimodori/tampermonkey-scripts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tanimodori/tampermonkey-scripts.git"
  },
  "license": "MIT",
  "author": "Tanimodori",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.probes.json && vite build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "test": "vite build && node dist/index.js",
    "test:live": "cross-env XIV_LIVE=1 vite build && node dist/index.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "cross-env": "^10.1.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "xiv-api-provider": "workspace:*",
    "xiv-datamine-polyfill": "workspace:*",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "@oxfmt/binding-win32-x64-msvc": "^0.67.0",
    "@oxlint/binding-win32-x64-msvc": "^1.82.0",
    "@rolldown/binding-win32-x64-msvc": "~1.2.6",
    "lightningcss-win32-x64-msvc": "^1.33.0"
  },
  "engines": {
    "node": ">=18"
  }
}
