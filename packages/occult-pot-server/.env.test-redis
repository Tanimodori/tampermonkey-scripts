# The `test:redis` task: the redis-tagged tests against a real server instead of the in-process mock.
#
#     OPS_ENV_PATH=.env.test-redis vitest --run --no-file-parallelism --tags-filter=redis
#     rushx test:redis
#
# Nothing else changes: the Tencent Docs upstream is still the in-process mock, so this file only
# names a Redis. `loadEnv` reads the ignored `.env.test-redis.local` on top of this file, so this
# one stays the committed default and the machine's own address goes there.
#
# The suite shares this server and empties it between cases, which is why `test:redis` runs without
# file parallelism. The WSL container the README sets up answers on 6399.

OPS_SERVER_REDIS_URL=redis://127.0.0.1:6399
