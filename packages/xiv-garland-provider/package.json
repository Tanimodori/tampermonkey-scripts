{
  "name": "xiv-garland-provider",
  "version": "0.0.1",
  "private": true,
  "description": "Online access to the Garland Tools Chinese mirror (garlandtools.cn): per-kind documents by id, the search endpoint and icon URLs.",
  "homepage": "https://github.com/Tanimodori/tampermonkey-scripts#readme",
  "bugs": {
    "url": "https://github.com/Tanimodori/tampermonkey-scripts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tanimodori/tampermonkey-scripts.git"
  },
  "license": "MIT",
  "author": "Tanimodori",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && vite build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest --run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "api-sdk-framework": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.1",
    "@types/node": "^22.10.5",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "~5.9.3",
    "universal-fetch-type": "workspace:*",
    "unplugin-dts": "^1.1.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "optionalDependencies": {
    "@oxfmt/binding-win32-x64-msvc": "^0.67.0",
    "@oxlint/binding-win32-x64-msvc": "^1.82.0",
    "@rolldown/binding-win32-x64-msvc": "~1.2.6",
    "lightningcss-win32-x64-msvc": "^1.33.0"
  }
}
