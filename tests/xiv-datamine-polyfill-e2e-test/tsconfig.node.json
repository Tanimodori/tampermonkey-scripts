{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /*
      The Node side of the example: the config file that configures the plugin, and the specs that read the
      built artifact back. `src/` reaches this program through `typeof import(…)` in `testUtils/artifact.ts`,
      which is why the wildcard client types have to be in `types` here too.

      `skipLibCheck: true` is inherited, so a dependency's own `.d.ts` is read and not judged — which is what
      keeps vitest's tree, `happy-dom` included, from settling this verdict. `vite.config.ts` still takes
      `defineConfig` from `vite` rather than from `vitest/config`: a consumer's own build config carries no test
      section, and copying that shape is what the example is for.
    */
    "types": ["node", "xiv-datamine-polyfill/client"]
  },
  "include": ["vite.config.ts", "test/**/*.ts"]
}
