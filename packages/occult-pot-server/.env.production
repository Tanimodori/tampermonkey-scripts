# Production values, as a template.
#
# This file **is** part of the delivery: `docker-compose.yml` lists it in `env_file`, as the middle of
# three layers, least specific first —
#
#     .env  <  .env.production (this file)  <  .env.production.local
#
# — so a deployment can either fill this one in or keep the real values in the git-ignored
# `.env.production.local`, which wins over it. (A value used inside the compose file itself, such as
# `OPS_NGINX_PORT`, comes from the shell or the project-directory `.env` instead: `env_file` only
# reaches the containers.)
#
# The placeholders below are deliberately **not** valid configuration: a production run without the
# real values fails while loading the configuration, instead of talking to a document that is not
# there. That failure is written to stderr and, when a log destination is configured below, to the log
# file as well.
#
# Everything else has a working default; the full list of variables, with comments, is
# `.env.development`.

# ---------------------------------------------------------------------------
# Tencent Docs (required)
# ---------------------------------------------------------------------------
OPS_DOCS_API_BASE=https://docs.qq.com

# The two ids a smartsheet call path carries — the API's `fileID` (the `300000000$…` form) and the
# sub-sheet's `sheetID` — not the sheet URL from the browser.
#
# Written exactly as the platform gives them: compose reads this file with `format: raw`
# (docker-compose.yml), so the `$` of a fileID arrives as written rather than being interpolated away.
OPS_DOCS_FILE_ID=<the production document's fileID, e.g. 300000000$abcdefghijkl>
OPS_DOCS_SHEET_ID=<the production document's sheetID, e.g. tXXXXXX>

# Client-Id from the Tencent Docs open platform, and the Access Token that authorises this service.
OPS_DOCS_CLIENT_ID=<Client-Id>
OPS_DOCS_ACCESS_TOKEN=<Access Token>

# Optional: only needed to refresh the access token (`upstreamStore.refresh()`, no scheduler yet).
# OPS_DOCS_CLIENT_SECRET=
# OPS_DOCS_REFRESH_TOKEN=
# OPS_DOCS_OPEN_ID=

# ---------------------------------------------------------------------------
# Redis (required in production: the in-process mock stores nothing that survives the process)
# ---------------------------------------------------------------------------
# Deployment data: compose passes it as `OPS_SERVER_REDIS_URL=redis://:<password>@redis:6379`.
# OPS_SERVER_REDIS_URL=redis://user:password@host:6379/0

# ---------------------------------------------------------------------------
# Logs (the system directory compose mounts to the repository's `./logs`)
# ---------------------------------------------------------------------------
# stdout keeps carrying every record — that is what `docker compose logs` reads — and this adds the
# rotating file behind it. The directory is created by the image and mounted by compose; the runtime
# user has to be able to write there.
OPS_LOG_ROTATING_FILE_PATH=/var/log/occult-pot-server/occult-pot-server.log
# 10 MiB per file, five rotated files behind the active one.
OPS_LOG_ROTATING_FILE_MAX_SIZE=10485760
OPS_LOG_ROTATING_FILE_MAX_FILES=5
# The plain file sink is the alternative (`OPS_LOG_FILE_PATH=…`, no rotation): the two are exclusive.
