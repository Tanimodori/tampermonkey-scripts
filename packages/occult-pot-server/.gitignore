node_modules/
dist/
# `.env.development` and `.env.production` are tracked — they are the complete lists of variable
# names, and only `.env.production` carries the few values a deployment must not leave at their
# defaults. Everything that holds one machine's or one deployment's own values is ignored: the
# `.local` files the app and compose read on top of a list, and `.env` itself, which compose loads
# automatically and the app reads as its lowest-priority source.
.env
.env.local
.env.*.local
rush-logs/
*.tsbuildinfo
# The container's log directory is a compose bind mount: the directory itself is tracked (so the
# mount target exists with sane ownership), what lands in it is not.
logs/*
!logs/.gitkeep
