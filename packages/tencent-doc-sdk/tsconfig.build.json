{
  "extends": "./tsconfig.json",
  // Not an emit configuration any more: vite bundles the JavaScript and `unplugin-dts` generates the
  // declarations from it, in the same pass. This file answers a different question — which sources are public
  // surface — and `tsconfig.json` cannot answer it because it also names `test/` and `vite.config.ts`.
  "include": ["src/**/*.ts"]
}
