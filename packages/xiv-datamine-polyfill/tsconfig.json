{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    /* Imports *inside `src/`* are relative, which is what keeps the generated declarations free of a
       specifier only this package understands. `@/` is therefore reserved for `test/`, and the alias below
       exists only so vitest and the type check agree on it. The end-to-end specs and the consumer-side checks
       live in `tests/xiv-datamine-polyfill-e2e-test`, where every import goes through this package's `exports`. */
    "paths": {
      "@/*": ["./src/*"]
    },
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "client.d.ts", "vite.config.ts"]
}
