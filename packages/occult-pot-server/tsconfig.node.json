{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    /* 构建与测试是 Node 侧：这里补上 node 类型，其余选项随 app 继承。 */
    "types": ["node"],
    /* `@test/…` 是 `test/` 下的模块，只有 spec 用；`paths` 是整体覆盖而非合并，`@` 需一并重述。 */
    "paths": {
      "@/*": ["./src/*"],
      "@test/*": ["./test/*"]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts", "test/**/*.ts", "src/**/*.d.ts"]
}
