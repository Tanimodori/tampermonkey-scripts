# The `test:api` task: the api-tagged live spec against the Tencent Docs **test** document — the same
# shape as the real one, but data that may be written to and deleted.
#
#     OPS_ENV_PATH=.env.test-api vitest --run --tags-filter=api
#     rushx test:api
#
# The test document is shared as
#     https://docs.qq.com/smartsheet/DR1pUZW5RUmRETFJp?nlc=1&tab=t00i2h
# Its `fileID` comes from the link's encoded id through
#     GET /openapi/drive/v2/util/converter?type=2&value=DR1pUZW5RUmRETFJp
#
# Coordinates and credential are the account's data: `loadEnv` reads the ignored
# `.env.test-api.local` on top of this file, so this one stays a template.
#
# A real upstream call costs quota shared with everything else, so this file paces harder than the
# defaults and keeps a retry budget for the occasional hiccup.

OPS_DOCS_API_BASE=https://docs.qq.com
OPS_DOCS_FILE_ID=300000000$replace-me
# `tab=` in the share link is the sub-sheet (`sheetID`); `viewId=` is not part of the record API.
OPS_DOCS_SHEET_ID=t00i2h

# Client-Id from the Tencent Docs open platform, and the Open-Id the credential belongs to.
OPS_DOCS_CLIENT_ID=replace-me
OPS_DOCS_OPEN_ID=replace-me
OPS_DOCS_ACCESS_TOKEN=replace-me

OPS_UPSTREAM_MAX_PER_INTERVAL=60
OPS_UPSTREAM_INTERVAL_MS=60000
OPS_UPSTREAM_MAX_RETRIES=2
