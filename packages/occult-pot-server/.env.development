# occult-pot-server configuration
#
# Every variable carries the service's own `OPS_` prefix, and is named after the configuration field
# it fills: `server.port` → `OPS_SERVER_PORT`, `docs.fileId` → `OPS_DOCS_FILE_ID`. The order below is
# the schema's.
#
# A run reads one merged environment, from the least specific source to the most specific one — each
# source overrides the one before it:
#
#     process.env  <  .env  <  .env.<mode>  <  .env.local  <  .env.<mode>.local  <  OPS_ENV_PATH  <  <OPS_ENV_PATH>.local
#
# `<mode>` is vite's `import.meta.env.MODE` (`development` under `rushx dev`, `production` for the
# built bundle, `test` under vitest). Files therefore **override** the ambient environment: the
# `OPS_` prefix keeps these names out of the way of anything else on the machine, and a file can
# always have the last word. Names the environment did not have yet are also written into
# `process.env`, but a variable it already carried is never overwritten there.
#
# `OPS_ENV_PATH` names one more file to read, with the highest priority. It is read from the real
# environment only, never from a file, and it comes as a pair — the named file, then its ignored
# `.local` sibling on top:
#
#     OPS_ENV_PATH=./.env.local-only        # also reads ./.env.local-only.local
#
# The `.local` files are git-ignored: put real credentials there and keep these files templates.
# `this file` is the **mock** environment: no Redis address (in-process mock) and a local upstream
# origin that nothing is expected to answer — the tests intercept that origin in-process, and
# `.env.production.local` / `.env.test-api.local` carry the real documents.
#
# Production is injected by docker-compose from `.env` and `.env.production` (both optional) plus the
# ignored `.env.production.local`; a container carries no env files at all.
#
# Tests come in three tasks (see README):
#
#     rushx test:unit     every test on mocks; this file's defaults, the upstream mocked in-process
#     rushx test:redis    the redis-tagged tests against the server `.env.test-redis` names
#     rushx test:api      the api-tagged tests against the test document `.env.test-api` names

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
OPS_SERVER_PORT=3000
OPS_SERVER_HOST=0.0.0.0
# Reverse proxy hops. Set this when running behind nginx/traefik, otherwise every request
# shares the proxy's IP and the per-IP throttling is wrong. Examples: `1`, `loopback`, `true`.
OPS_SERVER_TRUST_PROXY=false
# Comma separated origins, or `*` for any origin. Cross-origin reads only (GET/HEAD/OPTIONS);
# POST stays same-origin.
OPS_SERVER_CORS_ORIGINS=*
OPS_SERVER_JSON_BODY_LIMIT=64kb
# debug | info | warning | error
OPS_SERVER_LOG_LEVEL=info
# Redis: `redis://[username:password@]host:port/db`. This file leaves it out, which is what selects
# the in-process mock — nothing written there survives the process, and production logs a warning.
# Credentials belong to the address when the server wants them; a password that contains `@`, `:` or
# `#` has to be percent-encoded.
# OPS_SERVER_REDIS_URL=redis://127.0.0.1:6379

# ---------------------------------------------------------------------------
# Tencent Docs (required)
# ---------------------------------------------------------------------------
# The API origin. This template points at a local mock: nothing answers it, which is the point —
# `rushx dev` and the tests never reach Tencent Docs by accident. The vitest config supplies the port
# the tests use; a real document is named by `.env.production.local` or `.env.test-api.local`.
OPS_DOCS_API_BASE=http://127.0.0.1:3100

# The document coordinates, exactly the two ids a smartsheet call path carries — not the sheet URL
# from the browser. `OPS_DOCS_FILE_ID` is the API's `fileID` (the `300000000$…` form) and
# `OPS_DOCS_SHEET_ID` the sub-sheet (`sheetID`) inside it; both can be read off an existing authorised
# call, e.g. `…/files/{fileID}/sheets/{sheetID}`. The values below are placeholders: a real document is
# deployment data, so it goes in an ignored `.local` file (or, in a container, in the environment
# compose injects).
OPS_DOCS_FILE_ID=300000000$ExAmPlEfIlEiD
OPS_DOCS_SHEET_ID=tXXXXXX

# Client-Id from the Tencent Docs open platform.
OPS_DOCS_CLIENT_ID=replace-me
# Optional: only needed to refresh the access token (`upstreamStore.refresh()`, no scheduler yet).
# Both come from the one-time authorization-code flow; the Refresh Token is valid for a year.
# OPS_DOCS_CLIENT_SECRET=
# OPS_DOCS_REFRESH_TOKEN=
# Optional: only needed when the token has no `sub` claim.
# OPS_DOCS_OPEN_ID=

# Access Token. Valid for 30 days and carries its own `sub` (Open-Id) and `exp` claims, which is
# why `OPS_DOCS_OPEN_ID` can usually be left out.
OPS_DOCS_ACCESS_TOKEN=replace-me

# Warn (log + /readyz degraded) this long before the access token expires.
OPS_DOCS_TOKEN_EXPIRY_WARN_MS=259200000

# ---------------------------------------------------------------------------
# Throttling
# ---------------------------------------------------------------------------
OPS_RATE_LIMIT_IP_WINDOW_MS=60000
OPS_RATE_LIMIT_IP_MAX=120
OPS_RATE_LIMIT_WRITE_MAX=20

# ---------------------------------------------------------------------------
# Upstream queue (every Tencent Docs call: reads, appends and the startup check)
# ---------------------------------------------------------------------------
# Ten calls per three seconds, shared by every outbound call: reads, appends and the deletions the
# sweep issues. That is the pace the original client script used; the platform also caps the day
# (20k calls with a super membership), so this window is a burst bound, not the daily budget. The
# queue spaces the calls out evenly rather than firing them in one burst, and it only paces them: a
# retry is the transport's own business and does not come back through it.
OPS_UPSTREAM_MAX_PER_INTERVAL=10
OPS_UPSTREAM_INTERVAL_MS=3000
# Retries after the first attempt. A 429 waits out the Retry-After it sends (or the backoff below,
# whichever applies); OPS_UPSTREAM_RETRY_BACKOFF_MS is the wait for every other retryable failure.
OPS_UPSTREAM_MAX_RETRIES=2
OPS_UPSTREAM_RETRY_BACKOFF_MS=500
# Bounds one attempt: the connection, the response headers and the body alike.
OPS_UPSTREAM_TIMEOUT_MS=10000
# How long a read is answered from the cached pot list. Reads always fetch the whole table, so this
# TTL is the only staleness control; a read whose sheet call fails is answered from the cached
# snapshot with a warning.
OPS_UPSTREAM_CACHE_TTL=30000
# The original client script's cleanup: after a read, a row whose `最后一次进岛时间` is at least this
# old is deleted from the sheet (and from the cache), and so is any row that is not a usable pot at
# all. Three hours.
OPS_UPSTREAM_STALE_AFTER_MS=10800000
