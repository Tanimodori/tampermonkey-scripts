{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    /* 构建与测试是 Node 侧：这里补上 node 类型；浏览器 lib 随 app 继承（spec 会 import src/ 的模块）。 */
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts", "test/**/*.ts", "src/**/*.d.ts"]
}
