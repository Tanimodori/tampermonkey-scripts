# occult-pot-server configuration
#
# A local run reads the files vite's mode names — `import.meta.env.MODE`, most specific first:
#
#     .env.<mode>.local  →  .env.<mode>  →  .env     (.env.development.local → .env.development
#                                                     for `rushx dev`, .env.production.local →
#                                                     .env.production for a built bundle)
#
# A variable that is already set always wins, so the shell beats every file.
# `.env.<mode>.local` is git-ignored: put real credentials there and keep this file a template.
# Production is injected by docker-compose from `.env` and `.env.production` (both optional).

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
# Comma separated origins, or `*` for any origin. Cross-origin reads only (GET/HEAD/OPTIONS);
# POST stays same-origin.
CORS_ORIGINS=*
# Reverse proxy hops. Set this when running behind nginx/traefik, otherwise every request
# shares the proxy's IP and the per-IP throttling is wrong. Examples: `1`, `loopback`, `true`.
TRUST_PROXY=false
JSON_BODY_LIMIT=64kb
# debug | info | warning | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Tencent Docs (required)
# ---------------------------------------------------------------------------
# The sheet URL exactly as it appears in the browser, including the `tab` parameter which
# carries the smartsheet (智能表) sub-sheet ID. The coordinates below are placeholders: the real
# document is deployment data, so it goes in the git-ignored `.env.development.local` (or, in a
# container, in the environment compose injects).
TENCENT_DOCS_SHEET_URL=https://docs.qq.com/sheet/DXXXXXXXXXXXXXXX?tab=tXXXXXX

# Access-Token / Client-Id / Open-Id triple from the Tencent Docs open platform.
# An Access Token is valid for 30 days and carries its own `sub` (Open-Id) and `exp` claims,
# so TENCENT_DOCS_OPEN_ID can be omitted; set TENCENT_DOCS_ACCESS_TOKEN to it.
TENCENT_DOCS_ACCESS_TOKEN=replace-me
TENCENT_DOCS_CLIENT_ID=replace-me
# Optional: only needed when the token has no `sub` claim.
# TENCENT_DOCS_OPEN_ID=

# API origin. Override only for a mock upstream or a private deployment.
TENCENT_DOCS_API_BASE=https://docs.qq.com

# Optional: only needed to refresh the access token (`upstreamStore.refresh()`, no scheduler yet).
# Both come from the one-time authorization-code flow; the Refresh Token is valid for a year.
# TENCENT_DOCS_CLIENT_SECRET=
# TENCENT_DOCS_REFRESH_TOKEN=

# Warn (log + /readyz degraded) this long before the access token expires.
TOKEN_EXPIRY_WARN_MS=259200000

# ---------------------------------------------------------------------------
# Read cache
# ---------------------------------------------------------------------------
# How long a fetched snapshot is served before the sheet is read again. Reads always fetch the
# whole table and there is no caller-driven refresh, so this TTL is the only staleness control.
READ_CACHE_TTL_MS=30000

# ---------------------------------------------------------------------------
# Write queue (accepted appends, flushed to the sheet on this interval)
# ---------------------------------------------------------------------------
# How often whatever has been accepted is written upstream in one addRecords call. There is no
# batch size to tune and no backlog to cap, because a client writes one pot at a time and the
# upstream queue below already limits the drain rate.
WRITE_FLUSH_INTERVAL_MS=2000

# ---------------------------------------------------------------------------
# Throttling
# ---------------------------------------------------------------------------
RATE_LIMIT_IP_WINDOW_MS=60000
RATE_LIMIT_IP_MAX=120
RATE_LIMIT_WRITE_MAX=20

# ---------------------------------------------------------------------------
# Upstream queue (every Tencent Docs call: reads, appends and document resolution)
# ---------------------------------------------------------------------------
# The platform allows 150 calls/minute per fileID and 300/minute per openID; stay below that. The
# queue spaces the calls out evenly over the window rather than firing them in one burst.
UPSTREAM_RATE_LIMIT_MAX_PER_INTERVAL=120
UPSTREAM_RATE_LIMIT_INTERVAL_MS=60000
# Retries after the first attempt. A 429 pauses the whole queue and is retried from the same
# budget; UPSTREAM_RETRY_BACKOFF_MS is the base wait, and a 429 that carries Retry-After uses
# whichever is longer.
UPSTREAM_MAX_RETRIES=2
UPSTREAM_RETRY_BACKOFF_MS=500
# Bounds one attempt: the connection, the response headers and the body alike.
UPSTREAM_TIMEOUT_MS=10000
