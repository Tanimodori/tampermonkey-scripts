{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    /* Imports *inside `src/`* are relative, because tsc emits these files as-is for Node to load and it
       copies every specifier verbatim into the declarations too — an `@/…` would reach a consumer that has no
       idea what it means. `@/` is therefore reserved for `test/`, which is never emitted, and the alias below
       exists only so vitest and the type check agree on it. The end-to-end specs and the consumer probes live
       in `tests/xiv-datamine-polyfill-e2e-test`, where every import goes through this package's `exports`. */
    "paths": {
      "@/*": ["./src/*"]
    },
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "client.d.ts", "vite.config.ts"]
}
