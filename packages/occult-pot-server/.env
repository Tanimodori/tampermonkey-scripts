# occult-pot-server — the variable reference.
#
# This file is documentation and nothing else: every line is commented out, so it sets no variable
# anywhere. Docker Compose does read the project-directory `.env` for its own `${…}` interpolation,
# and the app's loader read it as its first source — with nothing active in it, neither gets anything
# from here. (That also means `OPS_NGINX_PORT` below cannot be set from this file: give it in the
# shell or in a `--env-file`.)
#
# Where real values go instead:
#
#     .env.development        the mock defaults a `rushx dev` run uses (tracked)
#     .env.production         the production template, placeholders included (tracked)
#     .env.test-redis         the Redis `test:redis` runs against (tracked)
#     .env.test-api           the test document `test:api` runs against (tracked)
#     .env.local              this machine's own shared values (ignored)
#     .env.<mode>.local       this machine's overrides for one mode (ignored)
#
# How a run reads them — least specific first, each source overriding the one before it:
#
#     process.env  <  .env  <  .env.<mode>  <  .env.local  <  .env.<mode>.local  <  OPS_ENV_PATH  <  <OPS_ENV_PATH>.local
#
# `<mode>` is vite's `import.meta.env.MODE` (`development` under `rushx dev`, `production` for the
# built bundle, `test` under vitest). Files therefore **override** the ambient environment: the `OPS_`
# prefix keeps these names out of the way of anything else on the machine, and a file always has the
# last word. A name the environment did not have yet is also written into `process.env`; one it
# already carried is never overwritten there.
#
# The tests come in three tasks, which is what the two `.env.test-*` pairs are for:
#
#     rushx test:unit     every test on mocks; no env file of its own
#     rushx test:redis    the redis-tagged tests against the server `.env.test-redis` names
#     rushx test:api      the api-tagged tests against the document `.env.test-api` names
#
# `format: raw` in docker-compose.yml: the container's env files are read literally, with no `$`
# interpolation, which is what lets a document id keep its `$`. The trade is that those files cannot
# use dotenv sugar — an inline ` # …` after a value would become part of it, and quotes would be kept.

# ---------------------------------------------------------------------------
# Compose (read by docker-compose.yml, not by the service)
# ---------------------------------------------------------------------------
# OPS_NGINX_PORT — optional, default 8080. The host port nginx publishes; nothing else is published.
# It is interpolated by compose, so it comes from the shell or from `--env-file` — not from this file
# and not from the env files the containers get.
# OPS_NGINX_PORT=8080

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
# OPS_SERVER_PORT — optional, default 3000. The internal port nginx proxies to.
# OPS_SERVER_PORT=3000

# OPS_SERVER_HOST — optional, default 0.0.0.0. A container has to bind every interface to be reachable
# from the network; `127.0.0.1` would make it unreachable even with a published port.
# OPS_SERVER_HOST=0.0.0.0

# OPS_SERVER_TRUST_PROXY — optional, default false. Reverse proxy hops: with one nginx in front, `1`
# makes Express read the client IP from the right-most `X-Forwarded-For` entry instead of the proxy's
# address, which is what keeps the per-IP throttling honest. Examples: `1`, `loopback`, `true`. The
# delivered compose file pins it to `1` in the service's `environment:`.
# OPS_SERVER_TRUST_PROXY=false

# OPS_SERVER_CORS_ORIGINS — optional, default `*`. Comma-separated origins, or `*`. Cross-origin reads
# only (GET/HEAD/OPTIONS); POST stays same-origin.
# OPS_SERVER_CORS_ORIGINS=*

# OPS_SERVER_JSON_BODY_LIMIT — optional, default 64kb. A larger body is refused with the service's own
# `ERR_PAYLOAD_TOO_LARGE` envelope; nginx's own limit sits well above it as a backstop.
# OPS_SERVER_JSON_BODY_LIMIT=64kb

# OPS_SERVER_LOG_LEVEL — optional, default info. `debug` | `info` | `warning` | `error`. `debug` adds
# the per-command Redis records the rate limiter generates and the outbound calls that waited in the
# pacing queue; every other record (requests, Tencent Docs calls, deletions, failures) is at `info` or
# above. See docs/logging.md.
# OPS_SERVER_LOG_LEVEL=info

# OPS_SERVER_REDIS_URL — optional, no default. `redis://[username:password@]host:port/db`. **Leaving
# it out is what selects the in-process `ioredis-mock`**: nothing written there survives the process,
# and production logs a warning about it. A container deployment points it at the `redis` service
# (`redis://redis:6379`).
# OPS_SERVER_REDIS_URL=redis://127.0.0.1:6379

# OPS_SERVER_REDIS_PASSWORD — optional, no default. The password, given *beside* the address so the
# address stays a plain value that is safe to log (the config field is `server.redisPassword`, hence
# the name). A password embedded in the URL still works; this one wins when both are set, and an empty
# value reads as absent. In docker-compose.yml the same variable is what Redis itself receives in
# `--requirepass`, so the two sides always agree — leave it out and Redis runs without
# authentication, which is only sane because its port is never published. The startup record
# `Configuration resolved` reports whether one was configured (`redis.passwordConfigured`).
# OPS_SERVER_REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Tencent Docs (the four marked required have no default: a run without them is refused at startup)
# ---------------------------------------------------------------------------
# OPS_DOCS_API_BASE — optional, default https://docs.qq.com. The API origin; only its origin is used,
# so a configured path or query is dropped. `.env.development` points it at a local mock that nothing
# answers, which is what keeps `rushx dev` and the unit tests away from the real API.
# OPS_DOCS_API_BASE=https://docs.qq.com

# OPS_DOCS_FILE_ID — required. The API's `fileID` (the `300000000$…` form), the document id a
# smartsheet call path carries — not the sheet URL from the browser. With `format: raw` in compose it
# is written exactly as the platform gives it, `$` included.
# OPS_DOCS_FILE_ID=300000000$abcdefghijkl

# OPS_DOCS_SHEET_ID — required. The sub-sheet's `sheetID` inside that document (`tab=…` in a share
# link is this; `viewId` is not part of the record API). Both ids can be read off an existing
# authorised call, `…/files/{fileID}/sheets/{sheetID}`.
# OPS_DOCS_SHEET_ID=tXXXXXX

# OPS_DOCS_CLIENT_ID — required. Client-Id of the application on the Tencent Docs open platform.
# OPS_DOCS_CLIENT_ID=…

# OPS_DOCS_ACCESS_TOKEN — required. The Access Token that authorises this service. Valid for 30 days
# and carrying its own `sub` (Open-Id) and `exp` claims, which is why `OPS_DOCS_OPEN_ID` can usually be
# left out.
# OPS_DOCS_ACCESS_TOKEN=…

# OPS_DOCS_CLIENT_SECRET — optional, only needed to refresh the token. Comes from the one-time
# authorization-code flow; `upstreamStore.refresh()` is the only caller and there is no scheduler yet.
# OPS_DOCS_CLIENT_SECRET=

# OPS_DOCS_REFRESH_TOKEN — optional, only needed to refresh the token (valid for a year). Same flow as
# the secret; the store refuses to refresh without both.
# OPS_DOCS_REFRESH_TOKEN=

# OPS_DOCS_OPEN_ID — optional, only needed when the token has no `sub` claim.
# OPS_DOCS_OPEN_ID=

# OPS_DOCS_TOKEN_EXPIRY_WARN_MS — optional, default 259200000 (3 days). Warn (a log record and a
# degraded `/readyz`) this long before the access token expires.
# OPS_DOCS_TOKEN_EXPIRY_WARN_MS=259200000

# The test document, for `test:api`: the same shape as the real one, with data that may be written to
# and deleted — `tab=t00i2h` in its share link is the sub-sheet, the fileID is what the converter
# endpoint answers for the link's encoded id, and the credential is that document's *own* application
# (the production credential has no permission on it). `.env.test-api` and its ignored `.local` sibling
# carry the values.

# ---------------------------------------------------------------------------
# Inbound throttling (per client IP, counted in Redis, shared by every instance)
# ---------------------------------------------------------------------------
# OPS_RATE_LIMIT_IP_WINDOW_MS — optional, default 60000. The sliding window both limiters count in.
# OPS_RATE_LIMIT_IP_WINDOW_MS=60000

# OPS_RATE_LIMIT_IP_MAX — optional, default 120. Requests allowed per window on the whole anonymous
# API.
# OPS_RATE_LIMIT_IP_MAX=120

# OPS_RATE_LIMIT_WRITE_MAX — optional, default 20. Requests allowed per window on writes (POST), which
# are tighter because every one of them spends outbound Tencent Docs quota.
# OPS_RATE_LIMIT_WRITE_MAX=20

# ---------------------------------------------------------------------------
# The outbound queue (every Tencent Docs call: reads, appends, and the deletions the sweep issues)
# ---------------------------------------------------------------------------
# OPS_UPSTREAM_MAX_PER_INTERVAL — optional, default 10. Calls per interval, shared by every outbound
# call. Ten per three seconds is the pace the original client script used; the platform also caps the
# day (20k calls with a super membership), so this window is a burst bound, not the daily budget.
# OPS_UPSTREAM_MAX_PER_INTERVAL=10

# OPS_UPSTREAM_INTERVAL_MS — optional, default 3000. The interval those calls are spread across: the
# queue spaces them evenly instead of firing a burst, and it only paces them — a retry is the
# transport's own business and does not come back through it.
# OPS_UPSTREAM_INTERVAL_MS=3000

# OPS_UPSTREAM_MAX_RETRIES — optional, default 2. Retries after the first attempt. A 429 waits out the
# `Retry-After` it sends, or the backoff below, whichever applies.
# OPS_UPSTREAM_MAX_RETRIES=2

# OPS_UPSTREAM_RETRY_BACKOFF_MS — optional, default 500. The wait before every other retryable
# failure: a transport error, an HTTP 5xx.
# OPS_UPSTREAM_RETRY_BACKOFF_MS=500

# OPS_UPSTREAM_TIMEOUT_MS — optional, default 10000. Bounds one attempt: the connection, the response
# headers and the body alike.
# OPS_UPSTREAM_TIMEOUT_MS=10000

# OPS_UPSTREAM_CACHE_TTL — optional, default 30000. How long a read is answered from the cached pot
# list. Reads always fetch the whole table, so this TTL is the only staleness control; a read whose
# sheet call fails is answered from the cached snapshot with a warning.
# OPS_UPSTREAM_CACHE_TTL=30000

# OPS_UPSTREAM_STALE_AFTER_MS — optional, default 10800000 (3 hours). The original client script's
# cleanup: after a read, a row whose `最后一次进岛时间` is at least this old is deleted from the sheet
# (and from the cache), and so is any row that is not a usable pot at all.
# OPS_UPSTREAM_STALE_AFTER_MS=10800000

# ---------------------------------------------------------------------------
# Logs on disk (optional: without a path, records go to stdout and stderr only)
# ---------------------------------------------------------------------------
# A file sink and a rotating file sink are alternatives, never both: the two `PATH` variables are
# mutually exclusive, and any other option in a group is an error without its `PATH`. The option
# defaults below are LogTape's own. Records are one JSON object per line, the same shape stdout gets;
# see docs/logging.md.
#
# OPS_LOG_FILE_PATH — optional, no default. The plain file sink's destination. The directory is
# created if it is missing; a path that cannot be written fails at startup.
# OPS_LOG_FILE_PATH=./logs/app.log

# OPS_LOG_FILE_LAZY — optional, default false. Open the file on the first write rather than at
# startup. (The rotating sink has no such option.)
# OPS_LOG_FILE_LAZY=false

# OPS_LOG_FILE_BUFFER_SIZE — optional, default 8192. Characters buffered before a write; `0` writes
# every record straight through.
# OPS_LOG_FILE_BUFFER_SIZE=8192

# OPS_LOG_FILE_FLUSH_INTERVAL_MS — optional, default 5000. Milliseconds after which a partial buffer
# is flushed anyway; `0` disables the timer. A shutdown flushes either way.
# OPS_LOG_FILE_FLUSH_INTERVAL_MS=5000

# OPS_LOG_ROTATING_FILE_PATH — optional, no default. The rotating sink's destination; production uses
# it, into the system directory docker-compose mounts to the repository's `./logs`.
# OPS_LOG_ROTATING_FILE_PATH=/var/log/occult-pot-server/occult-pot-server.log

# OPS_LOG_ROTATING_FILE_MAX_SIZE — optional, default 1048576 (1 MiB). Bytes the active file may reach
# before it rotates; the backups are named `…log.1`, `.2`, … , newest first.
# OPS_LOG_ROTATING_FILE_MAX_SIZE=1048576

# OPS_LOG_ROTATING_FILE_MAX_FILES — optional, default 5. Backups to keep, 1..1000.
# OPS_LOG_ROTATING_FILE_MAX_FILES=5

# OPS_LOG_ROTATING_FILE_BUFFER_SIZE — optional, default 8192. As `OPS_LOG_FILE_BUFFER_SIZE`.
# OPS_LOG_ROTATING_FILE_BUFFER_SIZE=8192

# OPS_LOG_ROTATING_FILE_FLUSH_INTERVAL_MS — optional, default 5000. As `OPS_LOG_FILE_FLUSH_INTERVAL_MS`.
# OPS_LOG_ROTATING_FILE_FLUSH_INTERVAL_MS=5000

# ---------------------------------------------------------------------------
# Redis (the variables themselves are in the HTTP server section above)
# ---------------------------------------------------------------------------
# The address is `OPS_SERVER_REDIS_URL`, the password `OPS_SERVER_REDIS_PASSWORD`. Two Redis servers
# exist around this repository, and neither needs a variable in this file:
#
#     the compose service    `redis` on the occult-pot network, AOF-persisted, no published port
#     the test container     WSL, 127.0.0.1:6399 — what `.env.test-redis` names, overridable from
#                            `.env.test-redis.local` (`redis://user:password@host:port/db`)
#
# Without an address the service uses an in-process mock, which is what every unit test and a bare
# `rushx dev` run get.

# ---------------------------------------------------------------------------
# OPS_ENV_PATH (read from the real environment only, never from a file)
# ---------------------------------------------------------------------------
# Optional. Names one more file to read, at the highest priority, as a pair — the file, then its
# ignored `.local` sibling on top:
#
#     OPS_ENV_PATH=./.env.local-only        # also reads ./.env.local-only.local
#
# That is how `rushx test:redis` and `rushx test:api` pick their environment. Naming a file that does
# not exist is an error; the `.local` sibling may be absent.
# OPS_ENV_PATH=.env.test-redis
