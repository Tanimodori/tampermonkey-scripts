{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    /*
      DOM and nothing else: `src/` is userscript-side code, so the absence of `node` in `types` is itself a
      fact being checked — a consumer can compile this example without ever installing Node types.
    */
    "lib": ["ES2022", "DOM"],
    "types": ["xiv-datamine-polyfill/client"],
    /*
      The point of the project. `skipLibCheck: true` would let a broken declaration pass: the packages emit
      `.d.ts` files whose specifiers and re-exports are a property of their build (for `xiv-api-provider`, of
      `build/finalize-types.ts`), and nothing inside either package checks that a consumer can read them. Here
      the library files are checked, so a declaration that cannot be resolved fails this compile.
    */
    "skipLibCheck": false,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src/**/*.ts"]
}
