{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    // Only the declarations are emitted here: `vite build` produced `dist/index.js` first, resolving the
    // `@/…` aliases as it bundled. `build/finalize-types.ts` relativizes what is left in these files.
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"]
}
