{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    /* `@/…` is a module under `src/`, `@test/…` one under `test/`; the aliases are declared for vite in
       vite.config.ts, which is what vitest and the bundle resolve through. `unplugin-dts` resolves them the
       same way while it generates the declarations, so nothing a consumer cannot read reaches `dist/` — the
       alias is affordable here precisely because a bundler, and not `tsc`, emits this package. */
    "paths": {
      "@/*": ["./src/*"],
      "@test/*": ["./test/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src/**/*.ts", "build/**/*.ts", "test/**/*.ts", "vite.config.ts"]
}
