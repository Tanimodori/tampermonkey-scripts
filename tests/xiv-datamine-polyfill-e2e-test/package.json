{
  "name": "xiv-datamine-polyfill-e2e-test",
  "version": "0.0.1",
  "private": true,
  "description": "The example consumer of xiv-datamine-polyfill and xiv-api-provider: target code that reads two generated sheets, the vite config that hooks the plugin up to it, and the end-to-end specs that judge the built artifact.",
  "homepage": "https://github.com/Tanimodori/tampermonkey-scripts#readme",
  "bugs": {
    "url": "https://github.com/Tanimodori/tampermonkey-scripts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tanimodori/tampermonkey-scripts.git"
  },
  "license": "MIT",
  "author": "Tanimodori",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && npm run build-only && npm test",
    "build-only": "vite build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "test": "npm run test:offline && npm run test:online",
    "test:offline": "vite build && vitest run test/offline.spec.ts",
    "test:online": "cross-env XIV_LIVE=1 vite build && cross-env XIV_LIVE=1 vitest run test/online.spec.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "cross-env": "^10.1.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "xiv-api-provider": "workspace:*",
    "xiv-datamine-polyfill": "workspace:*",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "@oxfmt/binding-win32-x64-msvc": "^0.67.0",
    "@oxlint/binding-win32-x64-msvc": "^1.82.0",
    "@rolldown/binding-win32-x64-msvc": "~1.2.6",
    "lightningcss-win32-x64-msvc": "^1.33.0"
  },
  "engines": {
    "node": ">=18"
  }
}
